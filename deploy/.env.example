# Configuration for a self-hosted Ziba. Copy to .env beside compose.yaml.
#
#   cp .env.example .env
#
# Everything Ziba needs is an environment variable, except the two YAML files in
# config/ — those are hand-edited documents and are mounted instead.
#
# Nothing in this file should ever be committed. Credentials are named here and
# read from the environment; they are never written into sources.yaml, and a
# source address carrying a password is refused at startup.

# --- The database -----------------------------------------------------------
# Any password you like: the database is not published outside the compose
# network, so this guards one container from another rather than the internet.
POSTGRES_PASSWORD=change-me
POSTGRES_USER=ziba

# --- The AI provider ---------------------------------------------------------
# openai or anthropic. Set the matching key and leave the other empty.
ZIBA_AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model names are REQUIRED and have no defaults, whichever provider you choose.
# A default written into the program is a claim about what exists, made once and
# never revisited; a stale one fails at the first article rather than at
# startup. Take the current names from the provider's own model list.
#
# The fast model assesses every article; the capable one writes summaries, and
# only for what clears the threshold. Examples, correct when written:
#
#   openai:     ZIBA_FAST_MODEL=gpt-5.6-luna
#               ZIBA_CAPABLE_MODEL=gpt-5.6-terra
#   anthropic:  ZIBA_FAST_MODEL=claude-haiku-4-5
#               ZIBA_CAPABLE_MODEL=claude-sonnet-5
ZIBA_FAST_MODEL=
ZIBA_CAPABLE_MODEL=

# How hard each model thinks: none, minimal, low, medium, high, xhigh, max.
# Empty takes the provider's default, which is the expensive one.
#
# This is the single setting that decides the bill. Reasoning tokens are charged
# as output and output costs several times input, so the default can cost more
# in thinking than the article costs to send. Neither job here is hard: one
# picks categories from a fixed list, the other writes four sentences.
#
# Ignored by models that have no reasoning setting, which is not an error.
ZIBA_FAST_EFFORT=low
ZIBA_CAPABLE_EFFORT=low

# --- A newsletter mailbox (optional) -----------------------------------------
# Only the credentials live here. Which server and which folder is a source in
# config/sources.yaml, because that is a description of where to read, not a
# secret. With Gmail this must be an App Password, not the account password,
# and it is pasted without the spaces the interface shows.
ZIBA_IMAP_USER=
ZIBA_IMAP_PASSWORD=

# --- The schedule ------------------------------------------------------------
# How often to collect, and when to build the day's selection. The digest time
# is local, so set TZ or it happens on UTC.
ZIBA_COLLECT_EVERY=6h
ZIBA_DIGEST_AT=06:30
TZ=Etc/UTC

# --- Where to reach it -------------------------------------------------------
# The host side of the port mapping, and nothing else. Inside the container Ziba
# always listens on 8080 — EXPOSE, the healthcheck and the mapping all assume
# it, and the program has no setting to move it. Changing ZIBA_PORT changes the
# address you type in a browser.
#
# ZIBA_BIND is which interface on this machine the port appears on. The default
# is every interface, so another device on your network can reach it as soon as
# the stack is up.
#
# Ziba has no accounts and no login: whoever reaches the port is the reader, and
# can mark articles read as well as read them. On a home network behind a router
# that is usually what you want. Two things to know before leaving the default:
#
#   - A published port is NOT covered by ufw. Docker writes its own firewall
#     rules, and they are consulted before the ones ufw manages, so enabling a
#     host firewall does not close this.
#   - If your router forwards this port, the instance is on the internet.
#
# ZIBA_BIND=127.0.0.1 allows only this machine, which is the right setting when
# a reverse proxy on the same host is terminating TLS and asking for a password.
# With Tailscale, this machine's own 100.x address is the middle ground: your
# devices, nothing else.
ZIBA_BIND=0.0.0.0
ZIBA_PORT=8080

# --- Debugging -----------------------------------------------------------
# Record every request made to a model, and its reply, in log/modelJournal.txt.
# Off unless you are working on a prompt.
#
# What it is for is the question that cannot be answered from outside: not what
# the model said, which is in the database, but what exactly it was asked. The
# prompt is assembled from the interests file, the article, a schema and several
# rules, and reading the assembled result beats reconstructing it by eye.
#
# It holds the full text of every article sent, so it grows at the rate of
# everything collected. Nothing is rotated or deleted. Headers are never
# recorded, so the API key is not in it.
ZIBA_MODEL_JOURNAL=false

# Where that file goes. In the compose stacks this directory is bind-mounted, so
# the file can be read from the host. On Linux the container runs as uid 65534,
# and a directory the host created as root will not be writable by it — the
# error at startup says so and names the fix.
ZIBA_LOG_DIR=log

# Pin a release instead of tracking latest, e.g. v0.1.0.
ZIBA_VERSION=latest
