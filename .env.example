# Copy to .env and fill in. The .env file is git-ignored: never commit secrets.

# Database credentials used by the ziba-db container.
POSTGRES_USER=ziba
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Connection string used by the ziba binary. Must match the values above.
#
# During development the binary runs on the laptop while the database runs on
# the homeserver, so 127.0.0.1 here means the local end of `make db-tunnel`.
# When the binary itself runs on the homeserver in Compose, the host becomes
# the service name: postgres://ziba:...@ziba-db:5432/ziba
ZIBA_DATABASE_URL=postgres://ziba:change-me@127.0.0.1:5432/ziba?sslmode=disable

# AI pipeline. Only `ziba process` needs this; collection and migration do not.
# Run `ziba process -offline` to work on the pipeline without a key or a cost.
# Which company answers the AI pipeline: anthropic (default) or openai.
ZIBA_AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which models. REQUIRED, whichever provider is chosen. Assessment runs on the
# fast one for every article; summarization runs on the capable one, and only
# above threshold.
#
# There are no defaults in the code, on purpose. A model name written into a
# program is a claim about what exists, made once and never revisited, and a
# stale one fails at the first article rather than at startup. Check the current
# names in the provider's own model list — not in a newsletter headline.
#
# Examples, correct when written and worth verifying before use:
#   anthropic:  ZIBA_FAST_MODEL=claude-haiku-4-5
#               ZIBA_CAPABLE_MODEL=claude-sonnet-5
#   openai:     ZIBA_FAST_MODEL=gpt-4o-mini
#               ZIBA_CAPABLE_MODEL=<a more capable model>
ZIBA_FAST_MODEL=
ZIBA_CAPABLE_MODEL=


# Newsletter mailbox credentials, if a newsletter source is configured.
# The source list names these variables; it never holds the values.
ZIBA_IMAP_USER=
ZIBA_IMAP_PASSWORD=

# Unattended schedule, used by `ziba serve`. Collection runs on an interval
# because feeds move through the day; the daily selection is built once, early,
# so it is waiting when you arrive. Set ZIBA_COLLECT_EVERY=0 to disable both.
ZIBA_COLLECT_EVERY=6h
ZIBA_DIGEST_AT=06:30

# Local timezone for the container: the digest is scheduled in local time.
TZ=Europe/Rome
ZIBA_PORT=8080
