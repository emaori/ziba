# Copy to .env and fill in. The .env file is git-ignored: never commit secrets.

# Which release to run. "latest" follows published releases; pin one, such as
# v0.1.0, to decide when to move.
ZIBA_VERSION=latest

# Database credentials used by the ziba-db container.
POSTGRES_USER=ziba
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Connection string used by the ziba binary when it runs outside Docker.
# Inside Docker, compose.yaml sets it and this value is ignored.
ZIBA_DATABASE_URL=postgres://ziba:change-me@127.0.0.1:5432/ziba?sslmode=disable

# AI pipeline.
# Which company answers the AI pipeline. Supported values: anthropic, openai.
ZIBA_AI_PROVIDER=openai

# API Key if AI provider is Anthropic
ANTHROPIC_API_KEY=
# API Key if AI provider is OpenAI
OPENAI_API_KEY=

# Which models. REQUIRED, whichever provider is chosen. Assessment (interest
# classification and score) runs on the fast one for every article;
# summarization runs on the capable one, and only above the threshold.
# Verify which name to use in the AI provider documentation.
#
# Examples:
#   anthropic:  ZIBA_FAST_MODEL=claude-haiku-4-5
#               ZIBA_CAPABLE_MODEL=claude-sonnet-5
#   openai:     ZIBA_FAST_MODEL=gpt-5.6-luna
#               ZIBA_CAPABLE_MODEL=gpt-5.6-terra
ZIBA_FAST_MODEL=
ZIBA_CAPABLE_MODEL=

# How hard each model thinks before answering: none, minimal, low, medium,
# high, xhigh, max. Optional — empty takes the provider's own default.
#
# This is the setting that decides the bill. Reasoning tokens are charged as
# output, and output costs six times input across the GPT-5 line, so the
# default (medium, on the models documented so far) can cost more in thinking
# than the whole article costs to send. Neither job here is hard: one picks
# categories from a fixed list and rounds a score to a multiple of five, the
# other writes four sentences.
#
# Ignored by models that have no reasoning setting, and never sent alongside a
# temperature — no model accepts both.
ZIBA_FAST_EFFORT=low
ZIBA_CAPABLE_EFFORT=low


# Newsletter mailbox credentials, if a newsletter source is configured.
# The source list names these variables; it never holds the values.
ZIBA_IMAP_USER=
ZIBA_IMAP_PASSWORD=

# Unattended schedule. Collection runs on an interval because feeds move
# through the day; the daily selection is built once, early.
# Set ZIBA_COLLECT_EVERY=0 to disable both.
ZIBA_COLLECT_EVERY=6h
ZIBA_DIGEST_AT=06:30

# Local timezone for the container: the digest is scheduled in local time.
TZ=Europe/Rome

# Which interface the container's port appears on. The default is 0.0.0.0, so a
# deployed instance is reachable from other devices. Set 127.0.0.1 so that only
# the host machine can reach it. Note that Ziba has no login: protecting it with
# an authenticating proxy is the operator's responsibility.
ZIBA_BIND=0.0.0.0

# The port on the host machine where the interface appears. The host
# side of the mapping and nothing else: inside the container Ziba always listens
# on 8080, and it has no setting to change that.
ZIBA_PORT=8080

# --- Debugging -----------------------------------------------------------
# Record every request made to a model, and its reply, in log/modelJournal.txt.
# Off unless you are working on a prompt.
#
# The prompt is assembled from the interests file, the article, a schema and
# several rules, and reading the assembled result beats reconstructing it by
# eye.
#
# It holds the full text of every article sent, so it grows at the rate of
# everything collected. Nothing is rotated or deleted. Headers are never
# recorded, so the API key is not in it.
ZIBA_MODEL_JOURNAL=false

# Where that file goes. In the compose stacks this directory is bind-mounted, so
# the file can be read from the host. On Linux the container runs as uid 65534,
# and a directory the host created as root will not be writable by it — the
# error at startup says so and names the fix.
ZIBA_LOG_DIR=log
